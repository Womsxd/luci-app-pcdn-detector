#!/bin/sh /etc/rc.common

# pcdn-detector 服务脚本（二进制 pcdn-detect）
#
# 说明：
#   - 配置文件由 UCI（/etc/config/pcdn-detector）指定，程序自身读取 TOML；
#   - 配置热重载通过 SIGHUP 完成（不重启进程、不丢失封禁状态）；
#   - 日志走 stdout/stderr，由 procd 写入系统日志（logread 可查）。

USE_PROCD=1

# opkg 的 default_prerm 卸载时会直接执行 "/etc/init.d/pcdn-detector stop"，
# 且不重定向输出；rc.common 在本脚本之后才加载 procd.sh，脚本内覆盖
# _procd_kill 会被它重新定义。因此 stop 期间直接丢弃 stderr：
# 服务未注册到 procd 时 ubus 会打印 "Command failed: Not found"。
if [ "$action" = "stop" ]; then
	exec 2>/dev/null
fi

START=99
STOP=01

CONFIG_NAME="pcdn-detector"
SECTION="main"

DEFAULT_BIN="/usr/bin/pcdn-detect"
DEFAULT_CFG="/etc/pcdn-detect/pcdn-detect.toml"

EXTRA_COMMANDS="isrunning version"
EXTRA_HELP="	isrunning	查看进程是否运行
	version		输出当前二进制版本"

load_options() {
	config_load "$CONFIG_NAME"
	config_get_bool enabled "$SECTION" enabled 0
	config_get bin_path "$SECTION" bin_path "$DEFAULT_BIN"
	config_get config_path "$SECTION" config_path "$DEFAULT_CFG"
	config_get extra_args "$SECTION" extra_args ""

	[ -n "$bin_path" ] || bin_path="$DEFAULT_BIN"
	[ -n "$config_path" ] || config_path="$DEFAULT_CFG"
}

# 让 pcdn-detect 自己生成默认配置（不再随包内嵌 TOML）
#   - 使用 --init-config <目录>：目录需已存在，成功时写出 pcdn-detect.toml；
#   - 生成后填入默认 br-lan，避免首次启动因 interface 为空校验失败；
#     不自动读取 network.lan.device，用户可在配置中自行改成实际网桥。
generate_config() {
	local dir tmp iface
	dir="$(dirname "$config_path")"
	tmp="/tmp/pcdn-detect-gen.$$"

	mkdir -p "$dir" 2>/dev/null
	rm -rf "$tmp"
	mkdir -p "$tmp" || return 1

	if ! "$bin_path" --init-config "$tmp" >/dev/null 2>&1; then
		rm -rf "$tmp"
		logger -t pcdn-detect "pcdn-detect --init-config 执行失败，无法生成默认配置"
		return 1
	fi

	if [ ! -s "$tmp/pcdn-detect.toml" ]; then
		rm -rf "$tmp"
		logger -t pcdn-detect "pcdn-detect 未能生成默认配置"
		return 1
	fi

	iface="br-lan"
	sed -i "s|^[[:space:]]*interface[[:space:]]*=[[:space:]]*\"\"[[:space:]]*$|interface = \"$iface\"|" "$tmp/pcdn-detect.toml"

	if ! mv -f "$tmp/pcdn-detect.toml" "$config_path"; then
		rm -rf "$tmp"
		logger -t pcdn-detect "无法写入配置文件：$config_path"
		return 1
	fi
	chmod 0644 "$config_path" 2>/dev/null
	rm -rf "$tmp"
	logger -t pcdn-detect "已由 pcdn-detect 生成默认配置：$config_path（网卡：$iface）"
	return 0
}

start_service() {
	load_options

	if [ "$enabled" != "1" ]; then
		return 0
	fi

	if [ ! -x "$bin_path" ]; then
		logger -t pcdn-detect "找不到可执行文件：$bin_path，请先在 LuCI「下载/更新」中安装"
		return 1
	fi

	if [ ! -f "$config_path" ]; then
		generate_config || return 1
	fi

	procd_open_instance
	# $extra_args 不加引号：按空格拆分为多个参数（命令行参数优先于 TOML）
	procd_set_param command "$bin_path" -c "$config_path" $extra_args
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="unlimited" nofile="65535 65535"
	procd_close_instance

	logger -t pcdn-detect "已启动：$bin_path -c $config_path $extra_args"
}

reload_service() {
	load_options

	local pids
	pids="$(pidof "$(basename "$bin_path")" 2>/dev/null)"
	if [ -n "$pids" ]; then
		# SIGHUP：pcdn-detect 原地重载配置（校验失败会保留旧配置继续运行）
		kill -HUP $pids 2>/dev/null
		logger -t pcdn-detect "已发送 SIGHUP，热重载配置"
	else
		logger -t pcdn-detect "服务未运行，跳过热重载"
	fi
}

stop_service() {
	load_options
	# pcdn-detect 收到 SIGTERM 后会兜底解封并清理防火墙规则
	logger -t pcdn-detect "正在停止服务"
}

service_triggers() {
	# UCI 变更后由 /sbin/reload_config 触发 reload
	procd_add_reload_trigger "$CONFIG_NAME"
}

isrunning() {
	load_options
	if pidof "$(basename "$bin_path")" >/dev/null 2>&1; then
		echo "running"
	else
		echo "stopped"
		return 1
	fi
}

version() {
	load_options
	[ -x "$bin_path" ] || { echo "binary not found: $bin_path"; return 1; }
	"$bin_path" -v 2>&1 | head -n 1
}
