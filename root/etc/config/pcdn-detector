config pcdn-detector 'main'
	# 是否开机自启
	option enabled '0'

	# pcdn-detect 的 TOML 配置文件（本页「配置」标签在线编辑）
	option config_path '/etc/pcdn-detect/pcdn-detect.toml'

	# pcdn-detect 可执行文件路径（也可在「下载/更新」中自动下载安装）
	option bin_path '/usr/bin/pcdn-detect'

	# 追加到启动命令的命令行参数，例如 "-i br-lan -n 30 -t 60s"
	# 命令行参数优先级高于 TOML 配置文件
	option extra_args ''

	# 更新检查 / 下载源：github 或 cnb
	option update_source 'github'

	# 二进制版本：go 或 c
	# C 版本使用末尾带 -c 的默认仓库（如 pcdn-detector-c），资源名与 Go 版本一致
	option build_variant 'go'

	# 代码仓库：记录当前使用的仓库；默认仓库由程序内置（GitHub / CNB 不同），
	# 切换源或版本时会自动回填并同步到该项；填写自定义仓库后原样使用
	option repo 'Womsxd/pcdn-detector'

	# 可选：完整覆盖下载地址前缀（如使用镜像 / 私有地址）
	# 留空时使用 https://github.com/<repo>/releases/latest/download
	option download_base ''

	# 空间不足时是否允许覆盖安装（默认关闭）：
	# 目标分区 < 16 MiB 且 /tmp < 24 MiB 时才生效，会先删除旧程序再下载，
	# 因此更新失败将无法自动回滚。
	option allow_overwrite '0'

	# 概览页是否直连 pcdn-detect 的 HTTP API（绕过 LuCI 代理，默认关闭）。
	# 需要 [http] listen 监听局域网地址、设置 token，且 cors_allowed_origins 包含本页来源；
	# 不满足时页面会自动回退到 LuCI 代理。
	option direct_api '0'
